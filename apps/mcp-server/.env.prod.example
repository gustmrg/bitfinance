# Image Tag (e.g., 0.5.1, latest)
MCP_IMAGE_TAG=latest

# BitFinance API
MCP_API_BASE_URL=http://bitfinance-api:8080
MCP_API_VERSION=1
MCP_AGENT_EMAIL=
MCP_AGENT_PASSWORD=
MCP_DEFAULT_ORGANIZATION_ID=

# MCP endpoint
MCP_BIND_ADDRESS=
MCP_PORT=8090
MCP_BEARER_TOKEN=

# Observability (Grafana Cloud)
MCP_OBSERVABILITY_ENABLED=false
MCP_TRACE_SAMPLING_RATIO=1.0
