  {
    "uid": "bf-api-errors",
    "title": "API HTTP errors",
    "ruleGroup": "bitfinance-operations",
    "folderUID": "${FOLDER_UID}",
    "condition": "B",
    "for": "2m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "application": "bitfinance",
      "severity": "high"
    },
    "annotations": {
      "summary": "API 5xx exceeds 5% with at least five requests in five minutes.",
      "runbook_url": "https://github.com/gustmrg/bitfinance/blob/main/apps/backend/observability/README.md"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "${PROMETHEUS_UID}",
        "model": {
          "refId": "A",
          "expr": "(sum(increase(http_server_request_duration_seconds_count{http_route!~\"/health.*\",job=\"bitfinance/bitfinance-api\",deployment_environment_name=\"production\",http_response_status_code=~\"5..\"}[5m])) / sum(increase(http_server_request_duration_seconds_count{http_route!~\"/health.*\",job=\"bitfinance/bitfinance-api\",deployment_environment_name=\"production\"}[5m])) > bool 0.05) and (sum(increase(http_server_request_duration_seconds_count{http_route!~\"/health.*\",job=\"bitfinance/bitfinance-api\",deployment_environment_name=\"production\"}[5m])) >= 5)",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query",
              "query": {
                "params": [
                  "B"
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "uid": "bf-api-latency",
    "title": "API p95 latency",
    "ruleGroup": "bitfinance-operations",
    "folderUID": "${FOLDER_UID}",
    "condition": "B",
    "for": "10m",
    "noDataState": "OK",
    "execErrState": "Error",
    "labels": {
      "application": "bitfinance",
      "severity": "medium"
    },
    "annotations": {
      "summary": "API p95 exceeds one second with sufficient traffic.",
      "runbook_url": "https://github.com/gustmrg/bitfinance/blob/main/apps/backend/observability/README.md"
    },
    "data": [
      {
        "refId": "A",
        "relativeTimeRange": {
          "from": 600,
          "to": 0
        },
        "datasourceUid": "${PROMETHEUS_UID}",
        "model": {
          "refId": "A",
          "expr": "(histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health.*\",job=\"bitfinance/bitfinance-api\",deployment_environment_name=\"production\"}[5m]))) > bool 1) and (sum(increase(http_server_request_duration_seconds_count{http_route!~\"/health.*\",job=\"bitfinance/bitfinance-api\",deployment_environment_name=\"production\"}[5m])) >= 5)",
          "instant": true,
          "range": false,
          "intervalMs": 1000,
          "maxDataPoints": 43200
        }
      },
      {
        "refId": "B",
        "relativeTimeRange": {
          "from": 0,
          "to": 0
        },
        "datasourceUid": "__expr__",
        "model": {
          "refId": "B",
          "type": "threshold",
          "expression": "A",
          "conditions": [
            {
              "evaluator": {
                "type": "gt",
                "params": [
                  0
                ]
              },
              "operator": {
                "type": "and"
              },
              "reducer": {
                "type": "last",
                "params": []
              },
              "type": "query",
              "query": {
                "params": [
                  "B"
                ]
              }
            }
          ]
        }
      }
    ]
  },
