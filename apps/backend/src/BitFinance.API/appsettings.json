{
  "ApplicationName": "bitfinance-api",
  "AppSettings": {
    "CacheEnabled": false,
    "LoggingEnabled": true
  },
  "ConnectionStrings": {
    "Database": "<connection-string-here>",
    "Cache": "<connection-string-here>"
  },
  "Jwt": {
    "Key": "<secret-key-with-at-least-256-bits>",
    "Issuer": "https://localhost:3000/bitfinance",
    "Audience": "https://localhost:3000/bitfinance",
    "ExpirationInMinutes": 120
  },
  "Cors": {
    "AllowedOrigins": ["https://localhost:3000", "http://localhost:3000"]
  },
  "Storage": {
    "BucketName": "",
    "Region": "us-east-1",
    "Prefix": "",
    "ServiceUrl": ""
  },
  "Notifications": {
    "EmailEnabled": false,
    "ResendApiToken": "",
    "ResendWebhookSecret": "",
    "FromAddress": "",
    "FrontendBaseUrl": "http://localhost:5174"
  },
  "KeyVault": {
    "Url": ""
  },
  "Observability": {
    "Enabled": false,
    "Environment": "",
    "TraceSamplingRatio": 1.0
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "AllowedHosts": "*"
}
