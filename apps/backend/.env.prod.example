# Image Tag (e.g., 1.7.0, latest)
IMAGE_TAG=latest
MCP_IMAGE_TAG=latest

# Database Configuration (REQUIRED - no defaults in production)
DB_USER=
DB_PASSWORD=
DB_NAME=
POSTGRES_DATA_VOLUME=bitfinance_postgres-data

# Redis Cache
REDIS_CONNECTION_STRING=bitfinance-cache:6379

# JWT Configuration (REQUIRED - no defaults in production)
# Generate a secure key: openssl rand -hex 32
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRATION=60

# Azure Key Vault Configuration (REQUIRED in production)
KEYVAULT_URL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# Cache Settings
CACHE_ENABLED=true

# CORS Configuration
CORS_ALLOWED_ORIGIN_0=

# Notifications (Resend)
NOTIFICATIONS_EMAIL_ENABLED=true
RESEND_API_TOKEN=
RESEND_WEBHOOK_SECRET=
NOTIFICATIONS_FROM_ADDRESS=
NOTIFICATIONS_FRONTEND_BASE_URL=

# MCP Server Configuration
MCP_API_BASE_URL=http://bitfinance-api:8080
MCP_AGENT_EMAIL=
MCP_AGENT_PASSWORD=
MCP_DEFAULT_ORGANIZATION_ID=
MCP_API_VERSION=1
MCP_BIND_ADDRESS=
MCP_PORT=8090
MCP_BEARER_TOKEN=

# Observability (Grafana Cloud OpenTelemetry)
# Obtain these values from Grafana Cloud > OpenTelemetry > Configure.
# Keep real values only in the ignored .env.prod/.env or deployment secret store.
GRAFANA_CLOUD_OTLP_ENDPOINT=https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
OTEL_TRACE_SAMPLING_RATIO=1.0

# Disable application exporters for rollback without removing health checks.
OBSERVABILITY_ENABLED=true
