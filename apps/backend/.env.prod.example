# Image Tag (e.g., 1.7.0, latest)
IMAGE_TAG=latest

# Database Configuration (REQUIRED - no defaults in production)
DB_USER=
DB_PASSWORD=
DB_NAME=
POSTGRES_DATA_VOLUME=bitfinance_postgres-data

# Redis Cache
REDIS_CONNECTION_STRING=bitfinance-cache:6379

# JWT Configuration (REQUIRED - no defaults in production)
# Generate a secure key: openssl rand -hex 32
JWT_KEY=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_EXPIRATION=60

# Azure Key Vault Configuration (REQUIRED in production)
KEYVAULT_URL=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=

# File storage (Amazon S3, REQUIRED in production)
S3_BUCKET_NAME=
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Google Sign-In
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Cache Settings
CACHE_ENABLED=true

# CORS Configuration
CORS_ALLOWED_ORIGIN_0=

# Network the reverse proxy reaches the API container from (the Docker bridge by default).
# The API reads the client IP from X-Forwarded-For only for requests coming from this network.
TRUSTED_PROXY_NETWORK=172.16.0.0/12

# Notifications (Resend)
NOTIFICATIONS_EMAIL_ENABLED=true
RESEND_API_TOKEN=
RESEND_WEBHOOK_SECRET=
NOTIFICATIONS_FROM_ADDRESS=
NOTIFICATIONS_FRONTEND_BASE_URL=

# Observability (Grafana Cloud)
OBSERVABILITY_ENABLED=false
OTEL_TRACE_SAMPLING_RATIO=1.0
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
