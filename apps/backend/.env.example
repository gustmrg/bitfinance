# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bitfinance

# Redis Cache
REDIS_CONNECTION_STRING=bitfinance-cache:6379

# JWT Configuration
JWT_KEY=your-development-key-at-least-32-characters-long
JWT_ISSUER=bitfinance-dev
JWT_AUDIENCE=bitfinance-dev
JWT_EXPIRATION=2880

# Cache Settings
CACHE_ENABLED=false

# Notifications (in-app is always enabled; email is opt-in locally)
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_TOKEN=
RESEND_WEBHOOK_SECRET=
NOTIFICATIONS_FROM_ADDRESS=BitFinance <notifications@example.com>
NOTIFICATIONS_FRONTEND_BASE_URL=http://localhost:5174
