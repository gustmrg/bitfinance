# Database Configuration
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bitfinance

# Redis Cache
REDIS_CONNECTION_STRING=bitfinance-cache:6379

# JWT Configuration
JWT_KEY=your-development-key-at-least-32-characters-long
JWT_ISSUER=bitfinance-dev
JWT_AUDIENCE=bitfinance-dev
JWT_EXPIRATION=2880

# Cache Settings
CACHE_ENABLED=false

# Notifications (in-app is always enabled; email is opt-in locally)
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_TOKEN=
RESEND_WEBHOOK_SECRET=
NOTIFICATIONS_FROM_ADDRESS=BitFinance <notifications@example.com>
NOTIFICATIONS_FRONTEND_BASE_URL=http://localhost:5174

# Optional local observability (used by docker-compose.observability.yml)
OBSERVABILITY_ENABLED=false
OBSERVABILITY_ENVIRONMENT=development
OTEL_TRACE_SAMPLING_RATIO=1.0
GRAFANA_CLOUD_OTLP_ENDPOINT=
GRAFANA_CLOUD_INSTANCE_ID=
GRAFANA_CLOUD_API_KEY=
MCP_AGENT_EMAIL=agent@example.com
MCP_AGENT_PASSWORD=local-development-password
MCP_DEFAULT_ORGANIZATION_ID=
MCP_BEARER_TOKEN=local-development-bearer-token
